# ===================================================================
# ResuMate AI — Environment Configuration Template
# ===================================================================
# Copy this file to backend/.env and replace placeholders with your actual values.
# NEVER commit backend/.env or root .env to source control!

PROJECT_NAME="ResuMate AI"
DATABASE_URL="sqlite:///./resumate.db"
SECRET_KEY="replace-with-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# -------------------------------------------------------------------
# Primary AI Provider: Groq API (High-speed inference)
# -------------------------------------------------------------------
# Obtain an API key from Groq Console: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# -------------------------------------------------------------------
# Fallback AI Provider: Google Gemini API (Official google-genai SDK)
# -------------------------------------------------------------------
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
# Used automatically if Groq is unavailable, rate-limited, or encounters a server error.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional tertiary provider: OpenAI
OPENAI_API_KEY=""
