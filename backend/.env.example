# ===================================================================
# ResuMate AI — Environment Configuration Template
# ===================================================================
# Copy this file to backend/.env and replace placeholders with your actual values.
# NEVER commit backend/.env to source control!

PROJECT_NAME="ResuMate AI"
DATABASE_URL="sqlite:///./resumate.db"
SECRET_KEY="replace-with-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# -------------------------------------------------------------------
# Google Gemini API Configuration (Official google-genai SDK)
# -------------------------------------------------------------------
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
# Leave empty to run with the built-in deterministic ATS heuristic NLP engine.
GEMINI_API_KEY="your-gemini-api-key-here"

# Supported models: gemini-3.8-flash, gemini-3.5-flash, gemini-3.1-flash-lite
GEMINI_MODEL="gemini-3.8-flash"

# Optional secondary provider
OPENAI_API_KEY=""

